{
  "manifest_version": 3,
  "name": "Echo — Communication Copilot",
  "version": "1.0.0",
  "description": "Local, privacy-first AI communication copilot that learns your personal writing style and generates smart replies on WhatsApp Web.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://www.instagram.com/*",
    "https://web.telegram.org/*",
    "https://discord.com/*",
    "https://x.com/*",
    "https://integrate.api.nvidia.com/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*",
        "https://www.instagram.com/*",
        "https://web.telegram.org/*",
        "https://discord.com/*",
        "https://x.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Echo Copilot"
  }
}
